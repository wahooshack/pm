{
  "database_name": "pm.db",
  "version": 2,
  "description": "SQLite schema for the local project management MVP with one board per authenticated user and room for future multi-user expansion.",
  "tables": [
    {
      "name": "users",
      "purpose": "Stores the signed-in users supported by the MVP and future multi-user expansion.",
      "columns": [
        {
          "name": "id",
          "type": "INTEGER",
          "constraints": [
            "PRIMARY KEY",
            "AUTOINCREMENT"
          ]
        },
        {
          "name": "username",
          "type": "TEXT",
          "constraints": [
            "NOT NULL",
            "UNIQUE"
          ]
        },
        {
          "name": "display_name",
          "type": "TEXT",
          "constraints": [
            "NOT NULL",
            "DEFAULT 'User'"
          ]
        },
        {
          "name": "created_at",
          "type": "TEXT",
          "constraints": [
            "NOT NULL",
            "DEFAULT CURRENT_TIMESTAMP"
          ]
        }
      ],
      "notes": [
        "This table is intentionally minimal for the MVP.",
        "The current app uses the hardcoded demo login, but the schema is ready for additional users later."
      ]
    },
    {
      "name": "boards",
      "purpose": "Stores the board for each user. The MVP only allows one board per user.",
      "columns": [
        {
          "name": "id",
          "type": "INTEGER",
          "constraints": [
            "PRIMARY KEY",
            "AUTOINCREMENT"
          ]
        },
        {
          "name": "user_id",
          "type": "INTEGER",
          "constraints": [
            "NOT NULL",
            "UNIQUE",
            "FOREIGN KEY REFERENCES users(id)"
          ]
        },
        {
          "name": "name",
          "type": "TEXT",
          "constraints": [
            "NOT NULL",
            "DEFAULT 'Main Board'"
          ]
        },
        {
          "name": "created_at",
          "type": "TEXT",
          "constraints": [
            "NOT NULL",
            "DEFAULT CURRENT_TIMESTAMP"
          ]
        },
        {
          "name": "updated_at",
          "type": "TEXT",
          "constraints": [
            "NOT NULL",
            "DEFAULT CURRENT_TIMESTAMP"
          ]
        },
        {
          "name": "revision",
          "type": "INTEGER",
          "constraints": [
            "NOT NULL",
            "DEFAULT 0"
          ]
        }
      ],
      "notes": [
        "One board per user. Writes compare and increment revision atomically."
      ]
    },
    {
      "name": "columns",
      "purpose": "Defines the ordered set of board columns and their display titles.",
      "columns": [
        {
          "name": "id",
          "type": "TEXT",
          "constraints": [
            "NOT NULL"
          ]
        },
        {
          "name": "board_id",
          "type": "INTEGER",
          "constraints": [
            "NOT NULL",
            "FOREIGN KEY REFERENCES boards(id)"
          ]
        },
        {
          "name": "title",
          "type": "TEXT",
          "constraints": [
            "NOT NULL"
          ]
        },
        {
          "name": "position",
          "type": "INTEGER",
          "constraints": [
            "NOT NULL",
            "DEFAULT 0"
          ]
        }
      ],
      "notes": [
        "The current frontend has five fixed columns: Backlog, Discovery, In Progress, Review, and Done.",
        "The position column preserves ordering between columns."
      ],
      "primary_key": [
        "board_id",
        "id"
      ]
    },
    {
      "name": "cards",
      "purpose": "Stores the cards inside each column, including card order and note content.",
      "columns": [
        {
          "name": "id",
          "type": "TEXT",
          "constraints": [
            "NOT NULL"
          ]
        },
        {
          "name": "board_id",
          "type": "INTEGER",
          "constraints": [
            "NOT NULL",
            "FOREIGN KEY REFERENCES boards(id)"
          ]
        },
        {
          "name": "column_id",
          "type": "TEXT",
          "constraints": [
            "NOT NULL"
          ]
        },
        {
          "name": "title",
          "type": "TEXT",
          "constraints": [
            "NOT NULL"
          ]
        },
        {
          "name": "details",
          "type": "TEXT",
          "constraints": [
            "NOT NULL",
            "DEFAULT 'No details yet.'"
          ]
        },
        {
          "name": "position",
          "type": "INTEGER",
          "constraints": [
            "NOT NULL",
            "DEFAULT 0"
          ]
        },
        {
          "name": "created_at",
          "type": "TEXT",
          "constraints": [
            "NOT NULL",
            "DEFAULT CURRENT_TIMESTAMP"
          ]
        },
        {
          "name": "updated_at",
          "type": "TEXT",
          "constraints": [
            "NOT NULL",
            "DEFAULT CURRENT_TIMESTAMP"
          ]
        }
      ],
      "notes": [
        "Cards are tracked by column_id and position so drag-and-drop ordering is preserved without storing a separate movement log.",
        "The details field replaces the current per-card metadata pattern used in the frontend demo.",
        "created_at/updated_at are reset by each board save (rows are replaced); they are not per-card history."
      ],
      "primary_key": [
        "board_id",
        "id"
      ],
      "foreign_keys": [
        {
          "columns": [
            "board_id",
            "column_id"
          ],
          "references": "columns(board_id,id)"
        }
      ]
    },
    {
      "name": "sessions",
      "purpose": "Hashed opaque server sessions with revocation and expiration.",
      "columns": [
        {
          "name": "token_hash",
          "type": "TEXT",
          "constraints": [
            "PRIMARY KEY"
          ]
        },
        {
          "name": "user_id",
          "type": "INTEGER",
          "constraints": [
            "NOT NULL",
            "FOREIGN KEY REFERENCES users(id)"
          ]
        },
        {
          "name": "expires_at",
          "type": "INTEGER",
          "constraints": [
            "NOT NULL"
          ]
        }
      ]
    }
  ],
  "relationship_summary": {
    "users": "one-to-one with boards",
    "boards": "one-to-many with columns and cards",
    "columns": "one-to-many with cards",
    "data_shape": "Each board has a fixed ordered column list, and each card belongs to one column with a position value."
  },
  "mvp_assumptions": [
    "The app will support a single board per user in the MVP.",
    "Authentication is still a simple hardcoded sign-in flow for the demo, but user records exist in the database model for future expansion.",
    "The board and all its columns/cards are stored in SQLite and recreated automatically if the database does not already exist.",
    "Column names and card order are persisted in the database rather than only in browser memory."
  ],
  "migration": "Startup adds boards.revision and rebuilds legacy columns/cards with board-scoped keys in one transaction, preserving data."
}
