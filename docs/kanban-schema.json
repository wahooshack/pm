{
  "database_name": "pm.db",
  "version": 3,
  "description": "SQLite schema for the project management app: user accounts with an admin role, multiple boards per user, board sharing, custom columns and cards with planning fields.",
  "tables": [
    {
      "name": "users",
      "purpose": "User accounts.",
      "columns": [
        {
          "name": "id",
          "type": "INTEGER",
          "constraints": [
            "PRIMARY KEY",
            "AUTOINCREMENT"
          ]
        },
        {
          "name": "username",
          "type": "TEXT",
          "constraints": [
            "NOT NULL",
            "UNIQUE"
          ]
        },
        {
          "name": "display_name",
          "type": "TEXT",
          "constraints": [
            "NOT NULL",
            "DEFAULT 'User'"
          ]
        },
        {
          "name": "created_at",
          "type": "TEXT",
          "constraints": [
            "NOT NULL",
            "DEFAULT CURRENT_TIMESTAMP"
          ]
        },
        {
          "name": "password_hash",
          "type": "TEXT",
          "constraints": [
            "NOT NULL",
            "DEFAULT ''"
          ]
        },
        {
          "name": "is_admin",
          "type": "INTEGER",
          "constraints": [
            "NOT NULL",
            "DEFAULT 0"
          ]
        },
        {
          "name": "is_active",
          "type": "INTEGER",
          "constraints": [
            "NOT NULL",
            "DEFAULT 1"
          ]
        }
      ],
      "notes": [
        "Usernames match ^[a-z0-9][a-z0-9_.-]{2,31}$.",
        "password_hash is scrypt$<salt hex>$<hash hex>.",
        "Disabled users cannot sign in and their sessions are ignored."
      ]
    },
    {
      "name": "boards",
      "purpose": "Boards owned by users; a user may own many.",
      "columns": [
        {
          "name": "id",
          "type": "INTEGER",
          "constraints": [
            "PRIMARY KEY",
            "AUTOINCREMENT"
          ]
        },
        {
          "name": "user_id",
          "type": "INTEGER",
          "constraints": [
            "NOT NULL",
            "FOREIGN KEY REFERENCES users(id)"
          ]
        },
        {
          "name": "name",
          "type": "TEXT",
          "constraints": [
            "NOT NULL",
            "DEFAULT 'Main Board'"
          ]
        },
        {
          "name": "revision",
          "type": "INTEGER",
          "constraints": [
            "NOT NULL",
            "DEFAULT 0"
          ]
        },
        {
          "name": "created_at",
          "type": "TEXT",
          "constraints": [
            "NOT NULL",
            "DEFAULT CURRENT_TIMESTAMP"
          ]
        },
        {
          "name": "updated_at",
          "type": "TEXT",
          "constraints": [
            "NOT NULL",
            "DEFAULT CURRENT_TIMESTAMP"
          ]
        }
      ],
      "notes": [
        "user_id is the owner.",
        "revision increments on every successful write; stale writes return 409."
      ]
    },
    {
      "name": "board_members",
      "purpose": "Users a board is shared with.",
      "columns": [
        {
          "name": "board_id",
          "type": "INTEGER",
          "constraints": [
            "NOT NULL",
            "PRIMARY KEY (board_id, user_id)",
            "FOREIGN KEY REFERENCES boards(id)"
          ]
        },
        {
          "name": "user_id",
          "type": "INTEGER",
          "constraints": [
            "NOT NULL",
            "FOREIGN KEY REFERENCES users(id)"
          ]
        },
        {
          "name": "role",
          "type": "TEXT",
          "constraints": [
            "NOT NULL",
            "CHECK (role IN ('editor', 'viewer'))"
          ]
        }
      ],
      "notes": [
        "Editors change cards and columns; viewers only read.",
        "Only the owner manages members."
      ]
    },
    {
      "name": "columns",
      "purpose": "Ordered columns of a board.",
      "columns": [
        {
          "name": "id",
          "type": "TEXT",
          "constraints": [
            "NOT NULL",
            "PRIMARY KEY (board_id, id)"
          ]
        },
        {
          "name": "board_id",
          "type": "INTEGER",
          "constraints": [
            "NOT NULL",
            "FOREIGN KEY REFERENCES boards(id)"
          ]
        },
        {
          "name": "title",
          "type": "TEXT",
          "constraints": [
            "NOT NULL"
          ]
        },
        {
          "name": "position",
          "type": "INTEGER",
          "constraints": [
            "NOT NULL"
          ]
        }
      ],
      "notes": [
        "A board has 1 to 20 columns with unique IDs."
      ]
    },
    {
      "name": "cards",
      "purpose": "Cards, each in exactly one column of its board.",
      "columns": [
        {
          "name": "id",
          "type": "TEXT",
          "constraints": [
            "NOT NULL",
            "PRIMARY KEY (board_id, id)"
          ]
        },
        {
          "name": "board_id",
          "type": "INTEGER",
          "constraints": [
            "NOT NULL",
            "FOREIGN KEY REFERENCES boards(id)"
          ]
        },
        {
          "name": "column_id",
          "type": "TEXT",
          "constraints": [
            "NOT NULL",
            "FOREIGN KEY (board_id, column_id) REFERENCES columns(board_id, id)"
          ]
        },
        {
          "name": "title",
          "type": "TEXT",
          "constraints": [
            "NOT NULL"
          ]
        },
        {
          "name": "details",
          "type": "TEXT",
          "constraints": [
            "NOT NULL",
            "DEFAULT 'No details yet.'"
          ]
        },
        {
          "name": "position",
          "type": "INTEGER",
          "constraints": [
            "NOT NULL"
          ]
        },
        {
          "name": "created_at",
          "type": "TEXT",
          "constraints": [
            "NOT NULL",
            "DEFAULT CURRENT_TIMESTAMP"
          ]
        },
        {
          "name": "updated_at",
          "type": "TEXT",
          "constraints": [
            "NOT NULL",
            "DEFAULT CURRENT_TIMESTAMP"
          ]
        },
        {
          "name": "due_date",
          "type": "TEXT",
          "constraints": []
        },
        {
          "name": "priority",
          "type": "TEXT",
          "constraints": []
        },
        {
          "name": "labels",
          "type": "TEXT",
          "constraints": [
            "NOT NULL",
            "DEFAULT '[]'"
          ]
        },
        {
          "name": "assignee_id",
          "type": "INTEGER",
          "constraints": [
            "FOREIGN KEY REFERENCES users(id)"
          ]
        }
      ],
      "notes": [
        "due_date is YYYY-MM-DD or null.",
        "priority is low, medium, high or null.",
        "labels is a JSON array of up to 10 unique labels (1-30 characters).",
        "assignee_id is the board owner or a member, or null."
      ]
    },
    {
      "name": "sessions",
      "purpose": "Expiring server sessions.",
      "columns": [
        {
          "name": "token_hash",
          "type": "TEXT",
          "constraints": [
            "PRIMARY KEY"
          ]
        },
        {
          "name": "user_id",
          "type": "INTEGER",
          "constraints": [
            "NOT NULL",
            "FOREIGN KEY REFERENCES users(id)"
          ]
        },
        {
          "name": "expires_at",
          "type": "INTEGER",
          "constraints": [
            "NOT NULL"
          ]
        }
      ],
      "notes": [
        "Only the SHA-256 hash of the cookie token is stored.",
        "Sessions last eight hours."
      ]
    }
  ]
}
